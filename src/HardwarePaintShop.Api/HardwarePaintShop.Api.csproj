<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HardwarePaintShop.Api</RootNamespace>
    <AssemblyName>HardwarePaintShop.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HardwarePaintShop.Application\HardwarePaintShop.Application.csproj" />
    <ProjectReference Include="..\HardwarePaintShop.Domain\HardwarePaintShop.Domain.csproj" />
    <ProjectReference Include="..\HardwarePaintShop.Infrastructure\HardwarePaintShop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
