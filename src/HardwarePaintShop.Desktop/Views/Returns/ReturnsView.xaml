<UserControl x:Class="HardwarePaintShop.Desktop.Views.Returns.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="المرتجعات الذكية" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="مرتجع مرتبط بالفاتورة الأصلية مع تحديث آمن للمخزون والسيريال والخزينة" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="8,0">
                <StackPanel><TextBlock Text="سطور مختارة" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedLines}" FontSize="21" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <StackPanel><TextBlock Text="إجمالي المرتجع" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ReturnTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel>
            </Border>
        </Grid>
        <TabControl Grid.Row="1">
            <TabItem Header="إنشاء مرتجع">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="325"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="1 — اختر الفاتورة" Style="{StaticResource SectionHeaderStyle}"/>
                            <Grid Grid.Row="1" Margin="0,5,0,10">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <ComboBox ItemsSource="{Binding ReturnTypes}" SelectedItem="{Binding SelectedReturnType}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/>
                                <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>
                                    <Button Grid.Column="1" Content="بحث" Command="{Binding SearchSourcesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="7,0,0,0"/>
                                </Grid>
                            </Grid>
                            <ListBox Grid.Row="2" ItemsSource="{Binding SourceInvoices}" SelectedItem="{Binding SelectedSource}" BorderThickness="0">
                                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8">
                                    <StackPanel><TextBlock Text="{Binding InvoiceNo}" FontWeight="SemiBold"/><TextBlock Text="{Binding PartyName}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" Foreground="{StaticResource PrimaryBrush}"/></StackPanel>
                                </Border></DataTemplate></ListBox.ItemTemplate>
                                <ListBox.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.LoadSourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></ListBox.InputBindings>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="2 — حدد الكميات" Style="{StaticResource SectionHeaderStyle}"/><TextBlock Text="{Binding SourceCaption}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                <Button Grid.Column="1" Content="كل المتاح" Command="{Binding SelectAllAvailableCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource AppDataGridStyle}" Margin="0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" IsReadOnly="True" Width="80"/>
                                    <DataGridTextColumn Header="متاح" Binding="{Binding AvailableQuantity, StringFormat=N3}" IsReadOnly="True" Width="75"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat=N2}" IsReadOnly="True" Width="85"/>
                                    <DataGridCheckBoxColumn Header="إضافة للمخزون" Binding="{Binding Restock}" Width="95"/>
                                    <DataGridTemplateColumn Header="الحالة" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}" Padding="4"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="السيريالات" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBox Text="{Binding SerialsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding AvailableSerialsText}" Foreground="#0F172A" CaretBrush="#0F172A" Padding="5"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" IsReadOnly="True" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding RefundMethods}" SelectedItem="{Binding SelectedRefundMethod}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Cashboxes}" SelectedItem="{Binding SelectedCashbox}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,0,8,0" IsEnabled="{Binding NeedsCashbox}"/>
                                <TextBox Grid.Column="2" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="ترحيل المرتجع" Command="{Binding PostCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="22,9"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="سجل المرتجعات">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ReturnSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>
                        <Button Grid.Column="1" Content="بحث" Command="{Binding SearchReturnsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentReturns}" Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Columns><DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNo}" Width="150"/><DataGridTextColumn Header="النوع" Binding="{Binding ReturnType}" Width="120"/>
                            <DataGridTextColumn Header="الفاتورة" Binding="{Binding OriginalInvoiceNo}" Width="140"/><DataGridTextColumn Header="الطرف" Binding="{Binding PartyName}" Width="*"/>
                            <DataGridTextColumn Header="القيمة" Binding="{Binding TotalAmount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="طريقة الرد" Binding="{Binding RefundMethod}" Width="140"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
