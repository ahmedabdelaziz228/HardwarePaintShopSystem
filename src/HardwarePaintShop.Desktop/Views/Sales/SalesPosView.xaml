<UserControl x:Class="HardwarePaintShop.Desktop.Views.Sales.SalesPosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             PreviewKeyDown="SalesPosView_PreviewKeyDown"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="نقطة البيع السريعة" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="امسح الباركود واضغط Enter — المخزون والخزينة وحساب العميل يتحدثوا معًا عند الترحيل"
                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ فاتورة جديدة  F2" Command="{Binding NewSaleCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanCreate}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="265"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="335"/>
            </Grid.ColumnDefinitions>

            <!-- Recent invoices -->
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="آخر الفواتير" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                            <TextBlock Text="{Binding Invoices.Count, StringFormat='{}{0} فاتورة'}" HorizontalAlignment="Left"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="InvoiceSearchBox" Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}" ToolTip="رقم الفاتورة أو العميل"
                                     KeyDown="InvoiceSearchBox_KeyDown" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="⌕" Command="{Binding LoadInvoicesCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="9,7"/>
                        </Grid>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" BorderThickness="0" Background="Transparent"
                                        HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,6">
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="9">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding InvoiceNo}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Left" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding CustomerName}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding InvoiceDate, StringFormat=dd/MM HH:mm}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" HorizontalAlignment="Left" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Barcode search and cart -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BarcodeBox" Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}" Height="46" FontSize="17"
                                 ToolTip="باركود / كود / اسم / سيريال" KeyDown="BarcodeBox_KeyDown" Margin="0,0,7,0"/>
                        <Button Grid.Column="1" Content="بحث" Command="{Binding SearchProductsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ProductResults}" SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="DisplayName" Style="{StaticResource AppComboBoxStyle}" Margin="0,0,7,0"/>
                        <Button Grid.Column="3" Content="+ إضافة" Command="{Binding AddProductCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanEditCurrent}"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="7" Padding="9" Margin="0,9,0,9">
                        <Grid>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="الفاتورة: "/><Run Text="{Binding InvoiceNo}" FontWeight="Bold"/>
                                <Run Text="   •   العميل: "/><Run Text="{Binding CustomerDisplay}" FontWeight="Bold"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding CartLines, StringFormat='{}{0} سطر'}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                                <TextBlock Text="   •   "/>
                                <TextBlock Text="{Binding CurrentStatus}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" Style="{StaticResource AppDataGridStyle}"
                              IsReadOnly="False" CanUserAddRows="False" RowHeight="58">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" IsReadOnly="True" Width="75"/>
                            <DataGridTextColumn Header="المتاح" Binding="{Binding StockStatus}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" IsReadOnly="True" Width="90"/>
                            <DataGridTemplateColumn Header="السيريالات" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SerialNumbersText, UpdateSourceTrigger=PropertyChanged}"
                                                 Foreground="#0F172A" CaretBrush="#0F172A" Background="White"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 IsEnabled="{Binding IsSerialTracked}" ToolTip="سيريال لكل قطعة: سطر أو فاصلة"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×" Foreground="{StaticResource ErrorBrush}" FontSize="18"
                                                Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                            CornerRadius="7" Padding="10" Margin="0,9,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter Property="Background" Value="#ECFDF5"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Checkout -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="بيانات البيع والتحصيل" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,0,6,0"
                                      ToolTip="اختر العميل للبيع الآجل" IsEnabled="{Binding CanEditCurrent}"/>
                            <Button Grid.Column="1" Content="نقدي" Command="{Binding UseCashCustomerCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"/>
                        </Grid>

                        <TextBlock Text="فئة السعر" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding PriceGroups}" SelectedItem="{Binding SelectedPriceGroup}"
                                  DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,9"
                                  IsEnabled="{Binding CanEditCurrent}"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="تاريخ الفاتورة" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding InvoiceDate}" Height="34" Margin="0,4,0,0" IsEnabled="{Binding CanEditCurrent}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الاستحقاق" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding DueDate}" Height="34" Margin="0,4,0,0" IsEnabled="{Binding CanEditCurrent}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="الإجمالي قبل الخصم" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:N2} ج.م'}" HorizontalAlignment="Left" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="خصم الفاتورة" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Width="115" HorizontalAlignment="Left" Style="{StaticResource AppTextBoxStyle}"
                                             IsEnabled="{Binding CanEditCurrent}"/>
                                </Grid>
                                <Separator/>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="صافي الفاتورة" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" HorizontalAlignment="Left"
                                               FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="المدفوع الآن" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AppTextBoxStyle}" Margin="0,4,6,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="تحصيل كامل" Command="{Binding SetFullPaymentCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Padding="10,8"/>
                        </Grid>

                        <Border Background="#FFF7ED" CornerRadius="7" Padding="10" Margin="0,0,0,9">
                            <Grid>
                                <TextBlock Text="المتبقي على العميل" Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="{Binding RemainingAmount, StringFormat='{}{0:N2} ج.م'}" HorizontalAlignment="Left"
                                           FontWeight="Bold" FontSize="16" Foreground="{StaticResource WarningBrush}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="الخزينة" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Cashboxes}" SelectedItem="{Binding SelectedCashbox}"
                                  DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,9"/>
                        <TextBlock Text="طريقة الدفع" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                  DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,9"/>
                        <TextBlock Text="ملاحظات" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Foreground="#0F172A" CaretBrush="#0F172A"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="58" Padding="8" Margin="0,4,0,10"
                                 IsEnabled="{Binding CanEditCurrent}"/>

                        <Button Content="ترحيل وإتمام البيع  F9" Command="{Binding PostCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsDraft}" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="حفظ مسودة" Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding CanEditCurrent}"/>
                            <Button Grid.Column="2" Content="إلغاء المسودة" Command="{Binding VoidDraftCommand}"
                                    Style="{StaticResource DangerButtonStyle}"/>
                        </Grid>
                        <Button Content="طباعة الفاتورة" Command="{Binding PrintReceiptCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,7,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
