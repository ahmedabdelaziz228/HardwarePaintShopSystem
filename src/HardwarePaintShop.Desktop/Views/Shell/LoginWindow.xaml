<Window x:Class="HardwarePaintShop.Desktop.Views.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تسجيل الدخول — نظام إدارة المحل"
        Height="500" Width="800" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#E2E8F0" FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Border Background="White" CornerRadius="14">
            <Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="4" Opacity="0.18"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="14,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#1E3A8A" Offset="0.6"/>
                            <GradientStop Color="#2563EB" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="30">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="18" Background="#33FFFFFF" HorizontalAlignment="Right">
                                <TextBlock Text="HP" Foreground="White" FontSize="23" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                            </Border>
                            <TextBlock Text="إدارة أذكى للمحل" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,22,0,8"/>
                            <TextBlock Text="منتجات، عملاء، موردون ومخزون في نظام واحد مصمم للمحل."
                                       Foreground="#DBEAFE" FontSize="13" TextWrapping="Wrap" LineHeight="21"/>
                            <StackPanel Margin="0,28,0,0">
                                <TextBlock Text="✓  صلاحيات للمستخدمين" Foreground="#BFDBFE" Margin="0,0,0,9"/>
                                <TextBlock Text="✓  بحث سريع بالباركود" Foreground="#BFDBFE" Margin="0,0,0,9"/>
                                <TextBlock Text="✓  قاعدة بيانات PostgreSQL" Foreground="#BFDBFE"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Version 1.1 Mobile RC1" Foreground="#93C5FD" FontSize="10"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="48,42">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="مرحبًا بعودتك" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="سجّل الدخول للمتابعة إلى لوحة التحكم" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="اسم المستخدم" Style="{StaticResource LabelStyle}" Margin="0,0,0,5"/>
                        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}" Tag="أدخل اسم المستخدم" Height="42" Margin="0,0,0,18"/>
                        <TextBlock Text="كلمة المرور" Style="{StaticResource LabelStyle}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource AppPasswordBoxStyle}" Height="42" Margin="0,0,0,10"/>
                        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#FEF2F2" CornerRadius="6" Padding="10,7" Margin="0,0,0,12">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                        <Button Content="تسجيل الدخول" Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="44" IsDefault="True"/>
                        <TextBlock Text="جاري التحقق من البيانات..." Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="بياناتك محفوظة بشكل آمن" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
