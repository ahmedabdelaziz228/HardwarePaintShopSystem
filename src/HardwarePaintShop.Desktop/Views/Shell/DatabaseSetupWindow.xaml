<Window x:Class="HardwarePaintShop.Desktop.Views.Shell.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعداد قاعدة البيانات" Height="610" Width="610" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="إعداد أول تشغيل" FontSize="26" FontWeight="Bold"/><TextBlock Text="اتصال PostgreSQL مطلوب قبل فتح البرنامج" Foreground="{StaticResource MutedBrush}" FontSize="14"/></StackPanel>
  <Border Grid.Row="1" Background="#FEF2F2" CornerRadius="8" Padding="11" Margin="0,0,0,14"><TextBlock x:Name="ErrorDetails" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" MaxHeight="80"/></Border>
  <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="السيرفر" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><TextBox x:Name="HostBox" Grid.Column="1" Text="localhost" Style="{StaticResource AppTextBoxStyle}" Margin="0,5"/>
   <TextBlock Grid.Row="1" Text="المنفذ" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Text="5432" Style="{StaticResource AppTextBoxStyle}" Margin="0,5"/>
   <TextBlock Grid.Row="2" Text="اسم قاعدة البيانات" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><TextBox x:Name="DatabaseBox" Grid.Row="2" Grid.Column="1" Text="hardware_paint_shop" Style="{StaticResource AppTextBoxStyle}" Margin="0,5"/>
   <TextBlock Grid.Row="3" Text="اسم المستخدم" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><TextBox x:Name="UsernameBox" Grid.Row="3" Grid.Column="1" Text="postgres" Style="{StaticResource AppTextBoxStyle}" Margin="0,5"/>
   <TextBlock Grid.Row="4" Text="كلمة المرور" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Height="37" Padding="9" Margin="0,5" Foreground="#0F172A"/>
   <CheckBox x:Name="CreateDatabaseBox" Grid.Row="5" Grid.Column="1" Content="إنشاء قاعدة البيانات تلقائيًا إذا لم تكن موجودة" IsChecked="True" Margin="0,9"/>
  </Grid></Border>
  <Grid Grid.Row="3" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/><Button Grid.Column="1" Content="إلغاء" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0"/><Button x:Name="SaveButton" Grid.Column="2" Content="اختبار وحفظ الاتصال" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="22,10"/></Grid>
 </Grid>
</Window>
