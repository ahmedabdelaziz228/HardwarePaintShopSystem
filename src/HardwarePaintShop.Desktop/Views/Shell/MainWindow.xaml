<Window x:Class="HardwarePaintShop.Desktop.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="نظام إدارة محل الحدايد والبوهيات"
        Height="820" Width="1360" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}" FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,20" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="HP" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="نظام إدارة المحل" Foreground="White" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="Hardware &amp; Paint" Foreground="#64748B" FontSize="10" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Border Background="#111C31" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="15" Background="#1D4ED8">
                                    <TextBlock Text="م" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="متصل الآن" Foreground="#34D399" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Command="{Binding LogoutCommand}" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↪" FontSize="17" Width="28"/>
                                <TextBlock Text="تسجيل الخروج" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,8">
                        <TextBlock Text="القائمة الرئيسية" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="16,0,16,7"/>
                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Style="{StaticResource NavButtonStyle}"
                                            IsEnabled="{Binding IsAvailable}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <Border Grid.Column="2" Background="#334155" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="قريبًا" FontSize="9" Foreground="#CBD5E1"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource ContentBackgroundBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="White" Height="64"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPageTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ShopName}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="○" Foreground="{StaticResource PrimaryBrush}" FontSize="15" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding CurrentDateTime, StringFormat='{}{0:dd MMMM yyyy  •  hh:mm tt}'}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF7ED" CornerRadius="8" Padding="10,7" Margin="10,0,0,0">
                                <TextBlock Text="{Binding UnreadAlertCount, StringFormat='{}{0} تنبيه'}" Foreground="{StaticResource WarningBrush}" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <ContentControl Content="{Binding CurrentPage}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
