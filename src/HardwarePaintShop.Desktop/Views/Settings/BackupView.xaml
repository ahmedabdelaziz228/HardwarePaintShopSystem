<UserControl x:Class="HardwarePaintShop.Desktop.Views.Settings.BackupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="النسخ الاحتياطي والاسترجاع" FontSize="24" FontWeight="Bold"/><TextBlock Text="نسخ PostgreSQL كاملة مع سجل نجاح وفشل ونسخة أمان قبل كل استرجاع" Foreground="{StaticResource MutedBrush}"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="إنشاء نسخة الآن" Style="{StaticResource SectionHeaderStyle}"/><TextBlock Text="مجلد الحفظ" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,5,0,10"/><Button Content="إنشاء نسخة احتياطية" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/><TextBlock Text="يتطلب وجود pg_dump في PATH، أو متغير PG_BIN يشير إلى مجلد bin الخاص بـ PostgreSQL." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15"><StackPanel><TextBlock Text="استرجاع نسخة" Style="{StaticResource SectionHeaderStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding RestoreFile}" IsReadOnly="True" Style="{StaticResource AppTextBoxStyle}"/><Button Grid.Column="1" Content="اختيار ملف" Command="{Binding BrowseRestoreCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="7,0,0,0"/></Grid><CheckBox Content="أفهم أن الاسترجاع سيستبدل البيانات الحالية" IsChecked="{Binding ConfirmRestore}" Margin="0,12" Foreground="{StaticResource ErrorBrush}"/><Button Content="إنشاء نسخة أمان ثم الاسترجاع" Command="{Binding RestoreCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right"/><TextBlock Text="بعد نجاح الاسترجاع يجب إعادة تشغيل البرنامج." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="سجل النسخ" Style="{StaticResource SectionHeaderStyle}"/><Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding History}" Style="{StaticResource AppDataGridStyle}" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="النوع" Binding="{Binding BackupType}" Width="100"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="الملف" Binding="{Binding FilePath}" Width="*"/><DataGridTextColumn Header="البداية" Binding="{Binding StartedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="النهاية" Binding="{Binding CompletedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="الخطأ" Binding="{Binding ErrorMessage}" Width="220"/></DataGrid.Columns></DataGrid></Grid></Border>
 </Grid>
</UserControl>
