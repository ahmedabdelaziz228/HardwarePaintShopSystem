<UserControl x:Class="HardwarePaintShop.Desktop.Views.Settings.LicenseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
 <Grid Margin="20" MaxWidth="800" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,15"><TextBlock Text="الترخيص والتفعيل" FontSize="24" FontWeight="Bold"/><TextBlock Text="ترخيص أوفلاين موقّع ومربوط بالجهاز" Foreground="{StaticResource MutedBrush}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20"><StackPanel><TextBlock Text="حالة الترخيص" Style="{StaticResource SectionHeaderStyle}"/><TextBlock Text="{Binding Status.Message}" FontSize="16" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="رقم الجهاز" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding MachineId}" FontFamily="Consolas" FontWeight="Bold"/></Grid><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="العميل" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Status.CustomerName}"/></Grid><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="الإصدار" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Status.Edition}"/></Grid><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ينتهي في" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Status.ExpiresAt, StringFormat=dd/MM/yyyy}"/></Grid></StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="إدخال كود تفعيل جديد" Style="{StaticResource SectionHeaderStyle}"/><TextBlock Text="انسخ رقم الجهاز وأرسله للبائع، ثم الصق الكود الموقّع هنا." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9"/><TextBox Text="{Binding LicenseCode, UpdateSourceTrigger=PropertyChanged}" Foreground="#0F172A" CaretBrush="#0F172A" AcceptsReturn="True" TextWrapping="Wrap" Height="95" Padding="9"/><Button Content="تفعيل النسخة" Command="{Binding ActivateCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="25,9"/><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/></StackPanel></Border>
 </Grid>
</UserControl>
