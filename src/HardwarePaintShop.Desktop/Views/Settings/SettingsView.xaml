<UserControl x:Class="HardwarePaintShop.Desktop.Views.Settings.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16" MaxWidth="950" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="إعدادات المحل" FontSize="24" FontWeight="Bold"/><TextBlock Text="بيانات رأس الفاتورة، الطابعة وسياسة النسخ الاحتياطي" Foreground="{StaticResource MutedBrush}"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="بيانات المنشأة" Style="{StaticResource SectionHeaderStyle}"/><TextBlock Text="اسم المحل" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Settings.ShopName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/><TextBlock Text="الهاتف" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Settings.ShopPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/><TextBlock Text="العنوان" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Settings.ShopAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/><TextBlock Text="الرقم الضريبي" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Settings.TaxNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><TextBlock Text="الطباعة والحماية" Style="{StaticResource SectionHeaderStyle}"/><TextBlock Text="عرض ورق الطابعة (مم)" Style="{StaticResource LabelStyle}"/><ComboBox ItemsSource="{Binding PrinterWidths}" SelectedItem="{Binding Settings.ThermalPrinterWidth}" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/><TextBlock Text="مجلد النسخ الاحتياطي" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Settings.BackupFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/><CheckBox Content="تشغيل نسخة احتياطية تلقائية يوميًا" IsChecked="{Binding Settings.AutoBackupEnabled}" Margin="0,6,0,12"/><TextBlock Text="الاحتفاظ بالنسخ (أيام)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Settings.BackupRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/><Border Background="#EFF6FF" CornerRadius="7" Padding="10"><TextBlock Text="للطباعة الحرارية استخدم 80 مم لمعظم طابعات نقاط البيع، أو 58 مم للطابعات الصغيرة." TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}"/></Border></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"/><Button Grid.Column="1" Content="حفظ الإعدادات" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="25,10"/></Grid>
 </Grid></ScrollViewer>
</UserControl>
