<UserControl x:Class="HardwarePaintShop.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="18" MaxWidth="1120" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="إعدادات المحل والفاتورة" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="كل البيانات الثابتة التي ستظهر على الفاتورة قابلة للتعديل من هنا"
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="بيانات المنشأة">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اسم المحل" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Settings.ShopName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                            <TextBlock Text="الهاتف" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Settings.ShopPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                            <TextBlock Text="العنوان" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Settings.ShopAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الرقم الضريبي" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Settings.TaxNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                            <TextBlock Text="السجل التجاري" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Settings.CommercialRegistration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                            <TextBlock Text="مسار شعار المحل" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.LogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="اختيار" Command="{Binding BrowseLogoCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="تصميم الفاتورة">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="عنوان المستند" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Settings.InvoiceTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                            <TextBlock Text="رمز العملة" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Settings.CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                            <TextBlock Text="مقاس الفاتورة" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding InvoicePaperSizes}" SelectedItem="{Binding Settings.InvoicePaperSize}"
                                      Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="تذييل الفاتورة" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Settings.InvoiceFooter, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}" Height="95" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10"/>
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="12">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}"
                                           Text="اختر A4 لفاتورة كاملة بالتفاصيل والأسعار والمدفوع والباقي. ولحفظ PDF اختر Microsoft Print to PDF من نافذة الطباعة."/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="النسخ الاحتياطي">
                <StackPanel Margin="18" MaxWidth="650">
                    <TextBlock Text="مجلد النسخ الاحتياطي" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Settings.BackupFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                    <CheckBox Content="تشغيل نسخة احتياطية تلقائية يوميًا" IsChecked="{Binding Settings.AutoBackupEnabled}" Margin="0,6,0,12"/>
                    <TextBlock Text="الاحتفاظ بالنسخ (أيام)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Settings.BackupRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                    <TextBlock Text="عرض طابعة الإيصالات القديمة (مم)" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PrinterWidths}" SelectedItem="{Binding Settings.ThermalPrinterWidth}" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"/>
            <Button Grid.Column="1" Content="حفظ كل الإعدادات" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="28,11"/>
        </Grid>
    </Grid>
</UserControl>
