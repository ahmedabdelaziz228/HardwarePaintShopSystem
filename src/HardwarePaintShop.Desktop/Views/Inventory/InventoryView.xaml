<UserControl x:Class="HardwarePaintShop.Desktop.Views.Inventory.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="المخزون والجرد" FontSize="24" FontWeight="Bold"/><TextBlock Text="أرصدة لحظية، كارت حركة، وجرد فعلي بتسوية مؤمّنة" Foreground="{StaticResource MutedBrush}"/></StackPanel>
   <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="8,0"><StackPanel><TextBlock Text="أصناف تحت الحد" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding LowStockCount}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12"><StackPanel><TextBlock Text="قيمة المخزون" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TotalStockValue, StringFormat='{}{0:N2} ج.م'}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border>
  </Grid>
  <TabControl Grid.Row="1">
   <TabItem Header="الأرصدة"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/><CheckBox Grid.Column="1" Content="تحت الحد فقط" IsChecked="{Binding LowOnly}" Margin="14,0" VerticalAlignment="Center"/><Button Grid.Column="2" Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Stock}" SelectedItem="{Binding SelectedProduct}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding ProductCode}" Width="110"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryName}" Width="130"/><DataGridTextColumn Header="الوحدة" Binding="{Binding BaseUnitName}" Width="80"/><DataGridTextColumn Header="الرصيد" Binding="{Binding QuantityBase, StringFormat=N3}" Width="90"/><DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinimumQuantity, StringFormat=N3}" Width="90"/><DataGridTextColumn Header="الحالة" Binding="{Binding StockStatus}" Width="95"/><DataGridTextColumn Header="متوسط التكلفة" Binding="{Binding AverageCost, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="القيمة" Binding="{Binding StockValue, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="سيريالات متاحة" Binding="{Binding AvailableSerials}" Width="100"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="كارت الحركة"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="اختر صنفًا من تبويب الأرصدة، أو اتركه فارغًا لكل الأصناف" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Margin="5,0"/><DatePicker Grid.Column="2" SelectedDate="{Binding ToDate}" Margin="5,0"/><Button Grid.Column="3" Content="عرض الحركة" Command="{Binding FilterMovementsCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Movements}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="النوع" Binding="{Binding MovementType}" Width="120"/><DataGridTextColumn Header="الكمية الأساسية" Binding="{Binding QuantityBase, StringFormat=N3}" Width="120"/><DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceType}" Width="110"/><DataGridTextColumn Header="البيان" Binding="{Binding Notes}" Width="220"/><DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="120"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="جرد فعلي"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="يمكن استخدام بحث الأرصدة لجرد مجموعة محددة" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="تحميل ورقة الجرد" Command="{Binding PrepareCountCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
    <DataGrid Grid.Row="1" ItemsSource="{Binding CountLines}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding ProductCode}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding BaseUnitName}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="رصيد النظام" Binding="{Binding SystemQuantity, StringFormat=N3}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="الفعلي" Binding="{Binding ActualQuantity, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="الفرق" Binding="{Binding Difference, StringFormat=N3}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="ملاحظة" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="180"/></DataGrid.Columns></DataGrid>
    <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CountNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Grid.Column="1" Text="{Binding TotalDifference, StringFormat='إجمالي الفروق: {0:N3}'}" VerticalAlignment="Center" Margin="12,0"/><Button Grid.Column="2" Content="حفظ وترحيل الجرد" Command="{Binding PostCountCommand}" Style="{StaticResource PrimaryButtonStyle}"/></Grid>
   </Grid></TabItem>
   <TabItem Header="سجل الجرد"><DataGrid ItemsSource="{Binding Counts}" Style="{StaticResource AppDataGridStyle}" Margin="10"><DataGrid.Columns><DataGridTextColumn Header="رقم الجرد" Binding="{Binding CountNo}" Width="160"/><DataGridTextColumn Header="النطاق" Binding="{Binding CountScope}" Width="100"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="الأصناف" Binding="{Binding ItemsCount}" Width="90"/><DataGridTextColumn Header="إجمالي الفروق" Binding="{Binding TotalAbsoluteDifference, StringFormat=N3}" Width="120"/><DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="التاريخ" Binding="{Binding ConfirmedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </Grid>
</UserControl>
