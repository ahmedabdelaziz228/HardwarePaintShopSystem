<UserControl x:Class="HardwarePaintShop.Desktop.Views.Inventory.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1180"
             FlowDirection="RightToLeft"
             Background="#F5F8FC">
    <UserControl.Resources>
        <Style x:Key="InventoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE6F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#334155" BlurRadius="12" ShadowDepth="1" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InventorySectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style x:Key="CompactActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="AdjustmentSegmentStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18,12,18,0" Padding="12,9" CornerRadius="8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#FECACA"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                            <Setter Property="Background" Value="#ECFDF5"/>
                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#B91C1C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                <Setter Property="Foreground" Value="#047857"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <Grid Grid.Row="1">
            <!-- Inventory list -->
            <ScrollViewer Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="18,16,18,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="3,0,3,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="المخزون والجرد" FontSize="25" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="إدارة الأصناف والكميات وحالة المخزون الرئيسي" Margin="0,4,0,0"
                                       Foreground="#64748B" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="كارت الحركة" Command="{Binding ShowMovementsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/>
                            <Button Content="جرد فعلي" Command="{Binding ShowCountCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/>
                            <Button Command="{Binding ShowAddProductCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding CanCreateProduct}" Padding="18,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊕" FontSize="18" Margin="0,0,7,0"/>
                                    <TextBlock Text="إضافة منتج" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InventoryCardStyle}" Padding="17" MinHeight="132">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="فئات المنتجات" Foreground="#475569"/>
                                    <TextBlock Text="{Binding CategoryCount}" FontSize="25" FontWeight="Bold" Foreground="#0F172A" Margin="0,14,0,0"/>
                                    <TextBlock Text="تصنيفات نشطة بالمخزون" Foreground="#64748B" FontSize="10.5" Margin="0,10,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23" Background="#E8F2FF" VerticalAlignment="Top">
                                    <TextBlock Text="◇" FontSize="25" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource InventoryCardStyle}" Padding="17" MinHeight="132">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="إجمالي المنتجات" Foreground="#475569"/>
                                    <TextBlock Text="{Binding ProductCount}" FontSize="25" FontWeight="Bold" Foreground="#0F172A" Margin="0,14,0,0"/>
                                    <TextBlock Text="منتج نشط" Foreground="#16A34A" FontSize="10.5" Margin="0,10,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23" Background="#E7F8F1" VerticalAlignment="Top">
                                    <TextBlock Text="□" FontSize="25" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource InventoryCardStyle}" Padding="17" MinHeight="132">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="قيمة المخزون" Foreground="#475569"/>
                                    <TextBlock Text="{Binding TotalStockValue, StringFormat='{}{0:N0} ج.م'}" FontSize="23" FontWeight="Bold" Foreground="#0F172A" Margin="0,14,0,0"/>
                                    <TextBlock Text="بالتكلفة المتوسطة" Foreground="#2563EB" FontSize="10.5" Margin="0,10,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23" Background="#EDE9FE" VerticalAlignment="Top">
                                    <TextBlock Text="▦" FontSize="23" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource InventoryCardStyle}" Padding="17" MinHeight="132" BorderBrush="#FED7AA">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="أصناف منخفضة" Foreground="#475569"/>
                                    <TextBlock Text="{Binding LowStockCount}" FontSize="25" FontWeight="Bold" Foreground="#0F172A" Margin="0,14,0,0"/>
                                    <TextBlock Text="تحتاج متابعة" Foreground="#EA580C" FontSize="10.5" Margin="0,10,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23" Background="#FFF1E8" VerticalAlignment="Top">
                                    <TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="#F97316" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource InventoryCardStyle}" Padding="14" MinHeight="430">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="قائمة المخزون" Style="{StaticResource InventorySectionTitleStyle}" Margin="3,0,3,12"/>
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <TextBox x:Name="InventorySearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}" Padding="34,9,11,9"
                                             ToolTip="ابحث بالاسم أو الكود أو الباركود" KeyDown="InventorySearchBox_KeyDown"/>
                                    <TextBlock Text="⌕" FontSize="19" Foreground="#64748B" HorizontalAlignment="Left"
                                               VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                </Grid>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryFilterOptions}"
                                          SelectedValue="{Binding SelectedCategoryFilterId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                                          Style="{StaticResource AppComboBoxStyle}" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding StockStatusOptions}"
                                          SelectedItem="{Binding SelectedStockStatus}"
                                          Style="{StaticResource AppComboBoxStyle}" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Command="{Binding ExportStockCommand}" IsEnabled="{Binding CanExport}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,8">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="⇩" FontSize="17" Margin="0,0,6,0"/><TextBlock Text="تصدير"/></StackPanel>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding PagedStock}" SelectedItem="{Binding SelectedProduct}"
                                      Style="{StaticResource AppDataGridStyle}" MinHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="المنتج" Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="7" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="▣" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding ImagePath}" Stretch="Uniform" Margin="2"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding PrimaryBarcode}" FontSize="9.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="الكود" Binding="{Binding ProductCode}" Width="100"/>
                                    <DataGridTextColumn Header="الفئة" Binding="{Binding CategoryName}" Width="120"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityBase, StringFormat=N2}" Width="85"/>
                                    <DataGridTextColumn Header="الوحدة" Binding="{Binding BaseUnitName}" Width="75"/>
                                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat='{}{0:N2} ج.م'}" Width="105"/>
                                    <DataGridTextColumn Header="المورد" Binding="{Binding MainSupplierName}" Width="125"/>
                                    <DataGridTemplateColumn Header="الحالة" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F8EF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StockStatus}" Value="منخفض"><Setter Property="Background" Value="#FFF3E5"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StockStatus}" Value="نفد المخزون"><Setter Property="Background" Value="#FEECEC"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding StockStatus}" Value="رصيد سالب"><Setter Property="Background" Value="#FEECEC"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StockStatus}" FontSize="10.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#078A4B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StockStatus}" Value="منخفض"><Setter Property="Foreground" Value="#EA580C"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StockStatus}" Value="نفد المخزون"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StockStatus}" Value="رصيد سالب"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="الإجراءات" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="±" ToolTip="تحديث كمية المخزون" Style="{StaticResource CompactActionButtonStyle}"
                                                            Command="{Binding DataContext.OpenAdjustmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="⌕" ToolTip="عرض كارت الحركة" Style="{StaticResource CompactActionButtonStyle}"
                                                            Command="{Binding DataContext.OpenMovementsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,11,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PageSummary}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="‹" Command="{Binding PreviousPageCommand}" Style="{StaticResource CompactActionButtonStyle}"/>
                                    <Border Background="#2563EB" CornerRadius="6" Padding="13,6" Margin="4,0">
                                        <TextBlock Text="{Binding PageNumberText}" Foreground="White" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                    </Border>
                                    <Button Content="›" Command="{Binding NextPageCommand}" Style="{StaticResource CompactActionButtonStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="لكل صفحة" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding SelectedPageSize}"
                                              Width="70" Style="{StaticResource AppComboBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Add product with opening balance -->
            <ScrollViewer Visibility="{Binding IsAddProductMode, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="18,16,18,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="3,0,3,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="المخزون والجرد  /  إضافة منتج" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="إضافة منتج جديد" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,7,0,0"/>
                            <TextBlock Text="أدخل بيانات المنتج والأسعار والرصيد الافتتاحي للمخزن الرئيسي" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="إلغاء" Command="{Binding ShowListCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Command="{Binding SaveNewProductCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,10">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Margin="0,0,7,0"/><TextBlock Text="حفظ المنتج"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.28*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.82*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource InventoryCardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="البيانات الأساسية" Style="{StaticResource InventorySectionTitleStyle}" Margin="0,0,0,14"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="اسم المنتج *" VerticalAlignment="Center" Foreground="#334155"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}" ToolTip="مثال: دهان بلاستيك أبيض 4 لتر"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="كود المنتج" VerticalAlignment="Center" Foreground="#334155"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewProductCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="الباركود" VerticalAlignment="Center" Foreground="#334155"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" FlowDirection="LeftToRight"/>
                                </Grid>
                                <Grid Grid.Row="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="التصنيف" VerticalAlignment="Center" Foreground="#334155"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedValue="{Binding NewCategoryId}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/>
                                </Grid>
                                <Grid Grid.Row="5" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="الوحدة الأساسية *" VerticalAlignment="Center" Foreground="#334155"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Units}" SelectedValue="{Binding NewBaseUnitId}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/>
                                </Grid>
                                <Grid Grid.Row="6" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="المورد" VerticalAlignment="Center" Foreground="#334155"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Suppliers}" SelectedValue="{Binding NewSupplierId}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/>
                                </Grid>
                                <Grid Grid.Row="7" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="صورة المنتج" VerticalAlignment="Top" Foreground="#334155" Margin="0,10,0,0"/>
                                    <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="9" Height="142" Background="#F8FAFC">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▣" FontSize="34" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                <TextBlock Text="إضافة صورة المنتج" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                    <Button Content="اختيار صورة" Command="{Binding BrowseNewProductImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"/>
                                                    <Button Content="إزالة" Command="{Binding ClearNewProductImageCommand}" Style="{StaticResource DangerButtonStyle}" Padding="10,5" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Image Source="{Binding NewProductImagePath}" Stretch="Uniform" Margin="8" HorizontalAlignment="Left" Width="125"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="130,13,0,0">
                                    <CheckBox Content="المنتج نشط" IsChecked="{Binding NewProductIsActive}" Margin="0,0,22,0"/>
                                    <CheckBox Content="يتتبع السيريال" IsChecked="{Binding NewProductIsSerialTracked}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource InventoryCardStyle}" Padding="17" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="المخزون الافتتاحي" Style="{StaticResource InventorySectionTitleStyle}"/>
                                    <TextBlock Text="الكمية الافتتاحية" Foreground="#475569" Margin="0,15,0,5"/>
                                    <TextBox Text="{Binding NewOpeningQuantity, UpdateSourceTrigger=LostFocus}" Style="{StaticResource AppTextBoxStyle}"/>
                                    <TextBlock Text="الحد الأدنى للمخزون" Foreground="#475569" Margin="0,11,0,5"/>
                                    <TextBox Text="{Binding NewMinimumQuantity, UpdateSourceTrigger=LostFocus}" Style="{StaticResource AppTextBoxStyle}"/>
                                    <Border Background="#EAF4FF" CornerRadius="7" Padding="11,8" Margin="0,13,0,0">
                                        <TextBlock Text="سيتم إنشاء حركة رصيد افتتاحي تلقائيًا بعد الحفظ." Foreground="#1D4ED8" FontSize="10.5" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="المخزن: المخزن الرئيسي" Foreground="#64748B" FontSize="10.5" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InventoryCardStyle}" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="التكلفة والأسعار" Style="{StaticResource InventorySectionTitleStyle}"/>
                                    <TextBlock Text="تكلفة شراء الوحدة" Foreground="#475569" Margin="0,15,0,5"/>
                                    <TextBox Text="{Binding NewPurchaseCost, UpdateSourceTrigger=LostFocus}" Style="{StaticResource AppTextBoxStyle}"/>
                                    <TextBlock Text="سعر البيع" Foreground="#475569" Margin="0,11,0,5"/>
                                    <TextBox Text="{Binding NewSalePrice, UpdateSourceTrigger=LostFocus}" Style="{StaticResource AppTextBoxStyle}"/>
                                    <TextBlock Text="فئة السعر" Foreground="#475569" Margin="0,11,0,5"/>
                                    <ComboBox ItemsSource="{Binding PriceGroups}" SelectedValue="{Binding NewPriceGroupId}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/>
                                    <Border Background="#F1F5F9" CornerRadius="7" Padding="11,8" Margin="0,12,0,0">
                                        <Grid><TextBlock Text="هامش الربح" Foreground="#64748B"/><TextBlock Text="{Binding NewProfitMargin, StringFormat='{}{0:0.0}%'}" HorizontalAlignment="Left" FontWeight="Bold" Foreground="#2563EB"/></Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource InventoryCardStyle}" Padding="14" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="إلغاء" Command="{Binding ShowListCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="حفظ المنتج" Command="{Binding SaveNewProductCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="30,10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Manual stock adjustment -->
            <ScrollViewer Visibility="{Binding IsAdjustmentMode, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="18,16,18,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="3,0,3,15">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="المخزون والجرد  /  تحديث المخزون" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="تحديث كمية المخزون" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,7,0,0"/>
                            <TextBlock Text="سجل حركة إضافة أو صرف أو تسوية للصنف" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="إلغاء" Command="{Binding ShowListCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="حفظ الحركة" Command="{Binding SaveAdjustmentCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="22,10"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource InventoryCardStyle}" Padding="17" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="9" Background="#F1F5F9">
                                <Grid><TextBlock Text="▣" Foreground="#94A3B8" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding SelectedProduct.ImagePath}" Stretch="Uniform" Margin="3"/></Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedProduct.ProductName}" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding SelectedProduct.ProductCode}" Foreground="#64748B" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="الفئة" FontSize="10" Foreground="#64748B"/><TextBlock Text="{Binding SelectedProduct.CategoryName}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="الرصيد الحالي" FontSize="10" Foreground="#64748B"/><TextBlock Text="{Binding SelectedProduct.QuantityBase, StringFormat='{}{0:N2}'}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="المخزن" FontSize="10" Foreground="#64748B"/><TextBlock Text="المخزن الرئيسي" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource InventoryCardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="بيانات حركة المخزون" Style="{StaticResource InventorySectionTitleStyle}" Margin="0,0,0,14"/>
                                <TextBlock Text="نوع الحركة" Foreground="#475569" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3" Margin="0,0,0,13">
                                    <Button Command="{Binding SetAdjustmentTypeCommand}" CommandParameter="add" Margin="0,0,4,0">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AdjustmentSegmentStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAddAdjustment}" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2563EB"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <TextBlock Text="⊕  إضافة مخزون"/>
                                    </Button>
                                    <Button Command="{Binding SetAdjustmentTypeCommand}" CommandParameter="remove" Margin="4,0">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AdjustmentSegmentStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsRemoveAdjustment}" Value="True"><Setter Property="Background" Value="#DC2626"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <TextBlock Text="⊖  صرف مخزون"/>
                                    </Button>
                                    <Button Command="{Binding SetAdjustmentTypeCommand}" CommandParameter="set" Margin="4,0,0,0">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AdjustmentSegmentStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSetAdjustment}" Value="True"><Setter Property="Background" Value="#7C3AED"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#7C3AED"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <TextBlock Text="≡  تسوية جرد"/>
                                    </Button>
                                </UniformGrid>
                                <TextBlock Text="الكمية *" Foreground="#475569" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=LostFocus}" Style="{StaticResource AppTextBoxStyle}" Margin="0,0,0,11"/>
                                <TextBlock Text="الوحدة" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="11,9" Margin="0,0,0,11"><TextBlock Text="{Binding AdjustmentUnitName}"/></Border>
                                <TextBlock Text="سبب الحركة *" Foreground="#475569" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding AdjustmentReasons}" SelectedItem="{Binding SelectedAdjustmentReason}" Style="{StaticResource AppComboBoxStyle}" Margin="0,0,0,11"/>
                                <TextBlock Text="رقم المرجع" Foreground="#475569" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AdjustmentReferenceNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,0,0,11" FlowDirection="LeftToRight"/>
                                <TextBlock Text="ملاحظات" Foreground="#475569" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding AdjustmentNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Height="68" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource InventoryCardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="معاينة الرصيد" Style="{StaticResource InventorySectionTitleStyle}"/>
                                <Grid Margin="0,25,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="الرصيد الحالي" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding AdjustmentPreviousBalance, StringFormat=N2}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="{Binding AdjustmentUnitName}" HorizontalAlignment="Center" Foreground="#64748B"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="+" FontSize="20" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="2"><TextBlock Text="الفرق" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding AdjustmentDifference, StringFormat='{}{0:+0.##;-0.##;0}'}" FontSize="25" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="{Binding AdjustmentUnitName}" HorizontalAlignment="Center" Foreground="#64748B"/></StackPanel>
                                    <TextBlock Grid.Column="3" Text="=" FontSize="20" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="4"><TextBlock Text="الرصيد بعد الحفظ" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding AdjustmentNewBalance, StringFormat=N2}" FontSize="27" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="{Binding AdjustmentUnitName}" HorizontalAlignment="Center" Foreground="#2563EB" FontWeight="SemiBold"/></StackPanel>
                                </Grid>
                                <Border Background="#EAF4FF" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"><TextBlock Text="سيتم تسجيل الحركة تلقائيًا في كارت الصنف وسجل المراجعة باسم المستخدم الحالي." Foreground="#1D4ED8" TextWrapping="Wrap" FontSize="11"/></Border>
                                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12,10"><TextBlock Text="راجع الكمية ونوع الحركة قبل الحفظ. لا يسمح النظام برصيد سالب." Foreground="#B45309" TextWrapping="Wrap" FontSize="11"/></Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="3" Style="{StaticResource InventoryCardStyle}" Padding="14" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="إلغاء" Command="{Binding ShowListCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="حفظ الحركة" Command="{Binding SaveAdjustmentCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="32,10"/></StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Movement history -->
            <Grid Visibility="{Binding IsMovementsMode, Converter={StaticResource BoolToVisibilityConverter}}" Margin="18,16,18,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="3,0,3,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="كارت حركة المخزون" FontSize="24" FontWeight="Bold"/><TextBlock Text="كل الحركات المسجلة للمخزن الرئيسي" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="العودة إلى المخزون" Command="{Binding ShowListCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/></Grid>
                <Border Grid.Row="1" Style="{StaticResource InventoryCardStyle}" Padding="13" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="اختر صنفًا من قائمة المخزون أو اعرض كل الحركات" Foreground="#64748B" VerticalAlignment="Center"/><DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Margin="6,0"/><DatePicker Grid.Column="2" SelectedDate="{Binding ToDate}" Margin="6,0"/><Button Grid.Column="3" Content="عرض الحركة" Command="{Binding FilterMovementsCommand}" Style="{StaticResource PrimaryButtonStyle}"/></Grid></Border>
                <Border Grid.Row="2" Style="{StaticResource InventoryCardStyle}" Padding="12"><DataGrid ItemsSource="{Binding Movements}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="النوع" Binding="{Binding MovementTypeName}" Width="120"/><DataGridTextColumn Header="الكمية" Binding="{Binding QuantityBase, StringFormat=N3}" Width="100"/><DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="90"/><DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceType}" Width="145"/><DataGridTextColumn Header="البيان" Binding="{Binding Notes}" Width="230"/><DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="130"/></DataGrid.Columns></DataGrid></Border>
            </Grid>

            <!-- Physical count -->
            <Grid Visibility="{Binding IsCountMode, Converter={StaticResource BoolToVisibilityConverter}}" Margin="18,16,18,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="3,0,3,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="الجرد الفعلي" FontSize="24" FontWeight="Bold"/><TextBlock Text="أدخل الكميات الفعلية وسيُنشئ النظام حركات التسوية" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="سجل الجرد" Command="{Binding ShowCountHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/><Button Content="العودة" Command="{Binding ShowListCommand}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Grid>
                <Border Grid.Row="1" Style="{StaticResource InventoryCardStyle}" Padding="13" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="سيتم تحميل الأصناف المطابقة لفلاتر قائمة المخزون الحالية" Foreground="#64748B" VerticalAlignment="Center"/><Button Grid.Column="1" Content="تحميل ورقة الجرد" Command="{Binding PrepareCountCommand}" Style="{StaticResource PrimaryButtonStyle}"/></Grid></Border>
                <Border Grid.Row="2" Style="{StaticResource InventoryCardStyle}" Padding="12"><DataGrid ItemsSource="{Binding CountLines}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding ProductCode}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding BaseUnitName}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="رصيد النظام" Binding="{Binding SystemQuantity, StringFormat=N3}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="الفعلي" Binding="{Binding ActualQuantity, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="الفرق" Binding="{Binding Difference, StringFormat=N3}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="ملاحظة" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="200"/></DataGrid.Columns></DataGrid></Border>
                <Border Grid.Row="3" Style="{StaticResource InventoryCardStyle}" Padding="13" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CountNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" ToolTip="ملاحظات الجرد"/><TextBlock Grid.Column="1" Text="{Binding TotalDifference, StringFormat='إجمالي الفروق: {0:N3}'}" VerticalAlignment="Center" Margin="12,0"/><Button Grid.Column="2" Content="حفظ وترحيل الجرد" Command="{Binding PostCountCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanCount}"/></Grid></Border>
            </Grid>

            <!-- Count history -->
            <Grid Visibility="{Binding IsCountHistoryMode, Converter={StaticResource BoolToVisibilityConverter}}" Margin="18,16,18,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="3,0,3,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="سجل الجرد" FontSize="24" FontWeight="Bold"/><TextBlock Text="عمليات الجرد المؤكدة للمخزن الرئيسي" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="العودة للجرد" Command="{Binding ShowCountCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/></Grid>
                <Border Grid.Row="1" Style="{StaticResource InventoryCardStyle}" Padding="12"><DataGrid ItemsSource="{Binding Counts}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="رقم الجرد" Binding="{Binding CountNo}" Width="170"/><DataGridTextColumn Header="النطاق" Binding="{Binding CountScope}" Width="110"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="الأصناف" Binding="{Binding ItemsCount}" Width="90"/><DataGridTextColumn Header="إجمالي الفروق" Binding="{Binding TotalAbsoluteDifference, StringFormat=N3}" Width="130"/><DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="التاريخ" Binding="{Binding ConfirmedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/></DataGrid.Columns></DataGrid></Border>
            </Grid>

            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="18,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                         Foreground="#2563EB" Panel.ZIndex="30"/>

            <!-- Product-created success modal -->
            <Grid Background="#990F2747" Panel.ZIndex="50"
                  Visibility="{Binding IsProductSuccessVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="500" Background="White" CornerRadius="13" Padding="25"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Button Content="×" Command="{Binding CloseProductSuccessCommand}" Style="{StaticResource DangerButtonStyle}"
                                FontSize="20" HorizontalAlignment="Left" Padding="5"/>
                        <Border Width="74" Height="74" CornerRadius="37" Background="#0EAD54" HorizontalAlignment="Center" Margin="0,-5,0,13">
                            <TextBlock Text="✓" FontSize="42" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="تمت إضافة المنتج بنجاح" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LastCreatedProductName, StringFormat='تمت إضافة {0} إلى المخزن الرئيسي.'}"
                                   Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,16" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="13,10" Margin="0,0,0,15">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LastCreatedProductCode, StringFormat='كود المنتج: {0}'}"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"><TextBlock Text="{Binding LastCreatedOpeningQuantity, StringFormat='الرصيد الافتتاحي: {0:N2} '}"/><TextBlock Text="{Binding LastCreatedUnitName}"/></StackPanel></Grid>
                        </Border>
                        <Button Content="عرض المنتج" Command="{Binding ViewCreatedProductCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"/>
                        <Button Content="إضافة منتج آخر" Command="{Binding AddAnotherProductCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
                        <Button Content="العودة إلى المخزون" Command="{Binding CloseProductSuccessCommand}" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
