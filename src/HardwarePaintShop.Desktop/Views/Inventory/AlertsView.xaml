<UserControl x:Class="HardwarePaintShop.Desktop.Views.Inventory.AlertsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="مركز التنبيهات" FontSize="24" FontWeight="Bold"/><TextBlock Text="نقص المخزون، الأرصدة السالبة والفواتير المتأخرة" Foreground="{StaticResource MutedBrush}"/></StackPanel><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="8,0"><StackPanel><TextBlock Text="غير مقروء" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding UnreadCount}" FontSize="21" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12"><StackPanel><TextBlock Text="حرج" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding CriticalCount}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/></StackPanel></Border></Grid>
  <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="التنبيهات الحالية" Style="{StaticResource SectionHeaderStyle}"/><CheckBox Grid.Column="1" Content="غير مقروء فقط" IsChecked="{Binding UnreadOnly}" Margin="10,0" VerticalAlignment="Center"/><Button Grid.Column="2" Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0"/><Button Grid.Column="3" Content="تعليم الكل كمقروء" Command="{Binding MarkAllReadCommand}" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" Style="{StaticResource AppDataGridStyle}"><DataGrid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding MarkReadCommand}" CommandParameter="{Binding SelectedAlert}"/></DataGrid.InputBindings><DataGrid.Columns><DataGridTextColumn Header="الخطورة" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="170"/><DataGridTextColumn Header="التفاصيل" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceType}" Width="110"/><DataGridCheckBoxColumn Header="مقروء" Binding="{Binding IsRead}" IsReadOnly="True" Width="70"/><DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/></DataGrid.Columns></DataGrid>
  </Grid></Border>
 </Grid>
</UserControl>
