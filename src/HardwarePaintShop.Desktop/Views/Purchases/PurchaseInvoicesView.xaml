<UserControl x:Class="HardwarePaintShop.Desktop.Views.Purchases.PurchaseInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="المشتريات الذكية" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="مسودة ← مراجعة التحويل والسيريال ← ترحيل ذري للمخزون والتكلفة والمورد والخزينة"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ فاتورة شراء جديدة" Command="{Binding NewInvoiceCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanCreate}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="الفواتير" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}" Tag="رقم الفاتورة أو المورد" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="بحث" Command="{Binding LoadInvoicesCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,7"/>
                        </Grid>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" BorderThickness="0" Background="Transparent"
                                        HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,7">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FAFCFF">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding InvoiceNo}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Left" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SupplierName}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                            <Grid Margin="0,5,0,0">
                                                <TextBlock Text="{Binding InvoiceDate, StringFormat=dd/MM/yyyy}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" HorizontalAlignment="Left" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="المورد *" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                      DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,0"
                                      IsEnabled="{Binding CanEditCurrent}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="رقمنا الداخلي" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding InternalInvoiceNo}" IsReadOnly="True" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,8">
                            <TextBlock Text="رقم فاتورة المورد" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SupplierInvoiceNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                     IsEnabled="{Binding CanEditCurrent}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,0,8">
                            <TextBlock Text="الحالة" Style="{StaticResource LabelStyle}"/>
                            <Border Background="#EFF6FF" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                <TextBlock Text="{Binding CurrentStatus}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="ملاحظات" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                     IsEnabled="{Binding CanEditCurrent}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="تاريخ الفاتورة" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding InvoiceDate}" Margin="0,4,0,0" Height="34"
                                        IsEnabled="{Binding CanEditCurrent}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="تاريخ الاستحقاق" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding DueDate}" Margin="0,4,0,0" Height="34"
                                        IsEnabled="{Binding CanEditCurrent}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3">
                            <TextBlock Text="تكاليف شحن/نقل" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ExtraCosts, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                     IsEnabled="{Binding CanEditCurrent}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="9" Margin="0,12,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}" Tag="اسم / كود / باركود / سيريال" Margin="0,0,7,0"/>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Content="بحث عن الصنف" Command="{Binding SearchProductsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ProductResults}" SelectedItem="{Binding SelectedProduct}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource AppComboBoxStyle}" Margin="0,0,7,0"/>
                            <Button Grid.Column="3" Content="+ إضافة للفاتورة" Command="{Binding AddProductCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanEditCurrent}"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" Style="{StaticResource AppDataGridStyle}"
                              IsReadOnly="False" CanUserAddRows="False" RowHeight="58">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="التحويل" Binding="{Binding ConversionPreview}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                            <DataGridTextColumn Header="بالأساسي" Binding="{Binding QuantityBaseUnit, StringFormat=0.###}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPurchasePrice, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N2}" IsReadOnly="True" Width="95"/>
                            <DataGridTemplateColumn Header="السيريالات (سطر/فاصلة)" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SerialNumbersText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 IsEnabled="{Binding IsSerialTracked}" ToolTip="رقم سيريال لكل قطعة"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×" Foreground="{StaticResource ErrorBrush}" FontSize="18" Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                                    CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                <Setter Property="Background" Value="#ECFDF5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حفظ مسودة" Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding CanEditCurrent}" Margin="0,0,7,0"/>
                                <Button Content="ترحيل نهائي" Command="{Binding PostCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding IsDraft}" Margin="0,0,7,0"/>
                                <Button Content="إلغاء / عكس" Command="{Binding VoidCommand}" Style="{StaticResource DangerButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="9" Padding="14,10" MinWidth="440">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="الإجمالي" Foreground="#94A3B8" FontSize="11"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat=N2}" Foreground="White" FontWeight="Bold" FontSize="17"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="المدفوع الآن" Foreground="#94A3B8" FontSize="11"/>
                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Height="27" Padding="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock Text="الخزينة" Foreground="#94A3B8" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding Cashboxes}" SelectedItem="{Binding SelectedCashbox}"
                                              DisplayMemberPath="Name" Height="27"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock Text="طريقة الدفع" Foreground="#94A3B8" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                              DisplayMemberPath="Name" Height="27"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
