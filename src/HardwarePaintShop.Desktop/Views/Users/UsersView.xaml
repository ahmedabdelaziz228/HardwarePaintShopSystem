<UserControl x:Class="HardwarePaintShop.Desktop.Views.Users.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Background="{StaticResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Form ===== -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}">
                    <Run Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter},
                            ConverterParameter='تعديل مستخدم|إضافة مستخدم جديد'}"/>
                </TextBlock>

                <!-- Status -->
                <Border Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                        Margin="0,0,0,12" Padding="12,8" CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Label Content="الاسم الكامل *" FontWeight="SemiBold" FontSize="13"/>
                <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}" Margin="0,0,0,10"/>

                <Label Content="اسم المستخدم *" FontWeight="SemiBold" FontSize="13"/>
                <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}" Margin="0,0,0,10"/>

                <Label FontWeight="SemiBold" FontSize="13">
                    <TextBlock>
                        <Run Text="كلمة المرور"/>
                        <Run Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter},
                                 ConverterParameter=' (اتركها فارغة لعدم التغيير)| *'}"
                             Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </TextBlock>
                </Label>
                <PasswordBox x:Name="PwdBox"
                             Style="{StaticResource AppPasswordBoxStyle}"
                             Margin="0,0,0,10"/>

                <Label Content="الدور / الصلاحية *" FontWeight="SemiBold" FontSize="13"/>
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedValue="{Binding FormRoleId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Style="{StaticResource AppComboBoxStyle}"
                          Margin="0,0,0,10"/>

                <CheckBox Content="الحساب نشط"
                          IsChecked="{Binding FormIsActive}"
                          Margin="0,0,0,16"
                          FontSize="13"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="💾 حفظ"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="➕ جديد"
                            Command="{Binding NewUserCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <ProgressBar IsIndeterminate="True" Height="3"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Foreground="{StaticResource PrimaryBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== Users List ===== -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <!-- Search -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Tag="🔍 بحث بالاسم أو اسم المستخدم..."/>
                        <Button Grid.Column="1" Content="🔄 تحديث"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="المستخدمون"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <DataGrid ItemsSource="{Binding Users}"
                          Style="{StaticResource AppDataGridStyle}"
                          SelectedItem="{Binding SelectedUser}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم الكامل"    Binding="{Binding FullName}"   Width="*"/>
                        <DataGridTextColumn Header="اسم المستخدم"    Binding="{Binding Username}"   Width="140"/>
                        <DataGridTextColumn Header="الدور"           Binding="{Binding Role.Name}"  Width="120"/>
                        <DataGridCheckBoxColumn Header="نشط"         Binding="{Binding IsActive}"   Width="60"/>
                        <DataGridTemplateColumn Header="إجراءات"     Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✏️"
                                                Command="{Binding DataContext.EditUserCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4" Margin="0,0,4,0"/>
                                        <Button Content="🚫"
                                                Command="{Binding DataContext.DeactivateCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="8,4"
                                                ToolTip="تعطيل الحساب"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
