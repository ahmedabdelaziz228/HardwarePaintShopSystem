<UserControl x:Class="HardwarePaintShop.Desktop.Views.Reports.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="التقارير والتحليل" FontSize="24" FontWeight="Bold"/><TextBlock Text="ملخص مالي، مبيعات يومية، أفضل الأصناف والأرصدة" Foreground="{StaticResource MutedBrush}"/></StackPanel><DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Margin="5,0" VerticalAlignment="Center"/><DatePicker Grid.Column="2" SelectedDate="{Binding ToDate}" Margin="5,0" VerticalAlignment="Center"/><Button Grid.Column="3" Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0"/><StackPanel Grid.Column="4" Orientation="Horizontal"><Button Content="تصدير CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0"/><Button Content="طباعة" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
   <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4"><StackPanel><TextBlock Text="صافي المبيعات" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Report.NetSales, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4"><StackPanel><TextBlock Text="المصروفات" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Report.Expenses, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4"><StackPanel><TextBlock Text="صافي الربح التقديري" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Report.EstimatedNetProfit, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4"><StackPanel><TextBlock Text="قيمة المخزون" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Report.StockValue, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4"><StackPanel><TextBlock Text="المشتريات" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Report.Purchases, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4"><StackPanel><TextBlock Text="مرتجعات البيع" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Report.SalesReturns, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4"><StackPanel><TextBlock Text="مديونية العملاء" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Report.CustomerDebt, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border>
   <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4"><StackPanel><TextBlock Text="مستحقات الموردين" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Report.SupplierDebt, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
  </UniformGrid>
  <TabControl Grid.Row="2" MinHeight="380">
   <TabItem Header="المبيعات اليومية"><DataGrid ItemsSource="{Binding Report.DailySales}" Style="{StaticResource AppDataGridStyle}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"/><DataGridTextColumn Header="الفواتير" Binding="{Binding InvoiceCount}" Width="110"/><DataGridTextColumn Header="المبيعات" Binding="{Binding Sales, StringFormat=N2}" Width="150"/><DataGridTextColumn Header="المدفوع" Binding="{Binding Paid, StringFormat=N2}" Width="150"/><DataGridTextColumn Header="المتبقي" Binding="{Binding Remaining, StringFormat=N2}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="الأصناف الأكثر مبيعًا"><DataGrid ItemsSource="{Binding Report.TopProducts}" Style="{StaticResource AppDataGridStyle}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="الكمية الأساسية" Binding="{Binding QuantityBase, StringFormat=N3}" Width="180"/><DataGridTextColumn Header="الإيراد" Binding="{Binding Revenue, StringFormat=N2}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="أرصدة العملاء"><DataGrid ItemsSource="{Binding Report.CustomerBalances}" Style="{StaticResource AppDataGridStyle}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="العميل" Binding="{Binding PartyName}" Width="*"/><DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="180"/><DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="150"/><DataGridTextColumn Header="حد الائتمان" Binding="{Binding Limit, StringFormat=N2}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="أرصدة الموردين"><DataGrid ItemsSource="{Binding Report.SupplierBalances}" Style="{StaticResource AppDataGridStyle}" Margin="8"><DataGrid.Columns><DataGridTextColumn Header="المورد" Binding="{Binding PartyName}" Width="*"/><DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="180"/><DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </Grid></ScrollViewer>
</UserControl>
