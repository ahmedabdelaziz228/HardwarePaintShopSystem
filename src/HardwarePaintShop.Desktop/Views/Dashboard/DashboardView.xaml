<UserControl x:Class="HardwarePaintShop.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Background="{StaticResource ContentBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
        <StackPanel>
            <Border CornerRadius="12" Padding="24,20" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1D4ED8" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="0.55"/>
                        <GradientStop Color="#0EA5E9" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Greeting}" FontSize="25" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="دي نظرة سريعة على حركة المحل والمخزون والحسابات"
                                   FontSize="13" Foreground="#DBEAFE" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                        <Button Content="تحديث البيانات" Command="{Binding RefreshCommand}"
                                Style="{StaticResource LightButtonStyle}"/>
                        <TextBlock Text="{Binding LastUpdatedText}" Foreground="#DBEAFE"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                    Background="#FEF2F2" CornerRadius="7" Padding="12,8" Margin="0,0,0,14">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
            </Border>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                         Foreground="{StaticResource PrimaryBrush}"/>

            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,16">
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="مبيعات اليوم" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding TodaySales, StringFormat='{}{0:N2} ج.م'}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{Binding SalesInvoiceCount, StringFormat='{}{0} فاتورة بيع'}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource KpiIconSuccessStyle}"><TextBlock Text="↗" FontSize="23" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="4,0,4,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="تحصيلات اليوم" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding TodayCollections, StringFormat='{}{0:N2} ج.م'}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource InfoBrush}"/>
                            <TextBlock Text="نقدي ومدفوعات العملاء" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource KpiIconInfoStyle}"><TextBlock Text="↓" FontSize="23" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="8,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="مصروفات اليوم" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding TodayExpenses, StringFormat='{}{0:N2} ج.م'}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource ErrorBrush}"/>
                            <TextBlock Text="إجمالي المصروفات المسجلة" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource KpiIconDangerStyle}"><TextBlock Text="↑" FontSize="23" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,4,8,0">
                    <StackPanel>
                        <TextBlock Text="رصيد الخزائن" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding CashboxBalance, StringFormat='{}{0:N2} ج.م'}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="الرصيد الحالي لكل الخزائن النشطة" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="4,4,4,0">
                    <StackPanel>
                        <TextBlock Text="مديونية العملاء" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding CustomerReceivables, StringFormat='{}{0:N2} ج.م'}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="مبالغ مستحقة للمحل" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="8,4,0,0">
                    <StackPanel>
                        <TextBlock Text="مستحقات الموردين" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding SupplierPayables, StringFormat='{}{0:N2} ج.م'}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource ErrorBrush}"/>
                        <TextBlock Text="مبالغ واجبة السداد" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="منتجات وصلت لحد الطلب" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                            <Border HorizontalAlignment="Left" Background="#FFF7ED" CornerRadius="10" Padding="10,3">
                                <TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} منتج'}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <DataGrid ItemsSource="{Binding LowStockProducts}" Style="{StaticResource AppDataGridStyle}" MinHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding CurrentQuantity, StringFormat=N3}" Width="100"/>
                                <DataGridTextColumn Header="حد الطلب" Binding="{Binding MinimumQuantity, StringFormat=N3}" Width="100"/>
                                <DataGridTextColumn Header="الوحدة" Binding="{Binding BaseUnitName}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="حالة البيانات" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="المنتجات النشطة" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveProductCount}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="العملاء النشطون" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveCustomerCount}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="الموردون النشطون" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveSupplierCount}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="فواتير شراء اليوم" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PurchaseInvoiceCount}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
