<UserControl x:Class="HardwarePaintShop.Desktop.Views.Parties.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="إدارة الموردين" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="بيانات موردي الحدايد والبويات ومتابعة المستحقات الحالية"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="عدد الموردين" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding SupplierCount}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="إجمالي مستحقات الموردين" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalPayables, StringFormat='{}{0:N2} ج.م'}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SupplierSearchBox" Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}" Tag="ابحث بالاسم أو الهاتف أو العنوان"
                         KeyDown="SupplierSearchBox_KeyDown" Margin="0,0,8,0"/>
                <CheckBox Grid.Column="1" Content="إظهار المعطّل" IsChecked="{Binding IncludeInactive}"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Grid.Column="2" Content="بحث" Command="{Binding LoadCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="+ مورد جديد" Command="{Binding NewSupplierCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanCreate}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" Height="3"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/>
                    <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                              Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المورد" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="125"/>
                            <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="170"/>
                            <DataGridTextColumn Header="المستحق" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="تعديل" Padding="8,4" Margin="0,0,4,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Padding="7,4" Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='تعطيل|تفعيل'}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                        <Run Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='تعديل بيانات المورد|إضافة مورد جديد'}"/>
                    </TextBlock>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Border Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                                Padding="10,7" CornerRadius="6" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border"><Setter Property="Background" Value="#FEF2F2"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter Property="Background" Value="#ECFDF5"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="حفظ المورد" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                            <Button Content="إلغاء" Command="{Binding NewSupplierCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="اسم المورد *" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                            <TextBlock Text="رقم الهاتف" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}" Tag="01xxxxxxxxx" Margin="0,4,0,10"/>
                            <TextBlock Text="العنوان" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="7" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="المستحق الحالي" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding FormCurrentBalance, StringFormat='{}{0:N2} ج.م'}"
                                               HorizontalAlignment="Left" FontWeight="Bold" FontSize="16"
                                               Foreground="{StaticResource ErrorBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="ملاحظات" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                                     VerticalScrollBarVisibility="Auto" Margin="0,4,0,10"/>
                            <CheckBox Content="المورد نشط" IsChecked="{Binding FormIsActive}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
