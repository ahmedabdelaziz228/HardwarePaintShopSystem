<Window x:Class="HardwarePaintShop.Desktop.Views.Parties.CustomerStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="كشف حساب العميل" Width="1120" Height="720"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="كشف حساب العميل" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="{Binding Statement.CustomerName}" FontSize="17" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="إغلاق" Click="Close_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,14,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <DatePicker SelectedDate="{Binding FromDate}" Height="35" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding ToDate}" Height="35" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Border Grid.Column="4" Background="#FFF7ED" CornerRadius="7" Padding="10" Margin="8,0">
                    <Grid><TextBlock Text="أول المدة" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Statement.OpeningBalance, StringFormat=N2}" HorizontalAlignment="Left" FontWeight="Bold"/></Grid>
                </Border>
                <Border Grid.Column="5" Background="#EFF6FF" CornerRadius="7" Padding="10">
                    <Grid><TextBlock Text="الرصيد الحالي" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Statement.ClosingBalance, StringFormat=N2}" HorizontalAlignment="Left" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
            <DataGrid ItemsSource="{Binding Statement.Lines}" Style="{StaticResource AppDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding TransactionType}" Width="120"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceNo}" Width="130"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <Button Grid.Column="1" Content="طباعة / حفظ PDF" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="24,10"/>
        </Grid>
    </Grid>
</Window>
