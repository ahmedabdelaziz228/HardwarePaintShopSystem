<UserControl x:Class="HardwarePaintShop.Desktop.Views.Finance.FinanceOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="الحسابات اليومية" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="مصروفات، قبض العملاء، دفع الموردين، حركة المالك والتحويل بين الخزائن"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0" Padding="13">
                <StackPanel><TextBlock Text="إجمالي الداخل" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalIn, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="13">
                <StackPanel><TextBlock Text="إجمالي الخارج" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalOut, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="365"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="تسجيل حركة جديدة" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="نوع الحركة" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding OperationOptions}" SelectedItem="{Binding SelectedOperation}"
                                  DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/>
                        <TextBlock Text="الخزينة" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Cashboxes}" SelectedItem="{Binding SelectedCashbox}"
                                  DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/>

                        <StackPanel Visibility="{Binding NeedsDestination, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="خزينة الوجهة" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Cashboxes}" SelectedItem="{Binding DestinationCashbox}"
                                      DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NeedsCustomer, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="العميل" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NeedsSupplier, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="المورد" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                      DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding NeedsExpenseCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="نوع المصروف" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ExpenseCategories}" SelectedItem="{Binding SelectedExpenseCategory}"
                                      DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" Margin="0,4,0,10"/>
                        </StackPanel>

                        <TextBlock Text="المبلغ" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" Margin="0,4,0,10"/>
                        <TextBlock Text="التاريخ" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding OperationDate}" Height="35" Margin="0,4,0,10"/>
                        <TextBlock Text="ملاحظات" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Foreground="#0F172A" CaretBrush="#0F172A"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="65" Padding="8" Margin="0,4,0,10"/>
                        <Border Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                                Background="#F8FAFC" CornerRadius="7" Padding="9" Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                        </Border>
                        <Button Content="حفظ الحركة" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="سجل الحركات" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFrom}" Height="34" Margin="6,0"/>
                        <DatePicker Grid.Column="2" SelectedDate="{Binding FilterTo}" Height="34" Margin="6,0"/>
                        <Button Grid.Column="3" Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <TabControl Grid.Row="1" Margin="0,10,0,0">
                        <TabItem Header="كل حركات الخزائن">
                            <DataGrid ItemsSource="{Binding Movements}" Style="{StaticResource AppDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                                    <DataGridTextColumn Header="الخزينة" Binding="{Binding CashboxName}" Width="130"/>
                                    <DataGridTextColumn Header="النوع" Binding="{Binding MovementType}" Width="145"/>
                                    <DataGridTextColumn Header="اتجاه" Binding="{Binding Direction}" Width="70"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="البيان" Binding="{Binding Notes}" Width="*"/>
                                    <DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="المصروفات">
                            <DataGrid ItemsSource="{Binding Expenses}" Style="{StaticResource AppDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding ExpenseDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                                    <DataGridTextColumn Header="النوع" Binding="{Binding CategoryName}" Width="170"/>
                                    <DataGridTextColumn Header="الخزينة" Binding="{Binding CashboxName}" Width="150"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                                    <DataGridTextColumn Header="البيان" Binding="{Binding Notes}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
