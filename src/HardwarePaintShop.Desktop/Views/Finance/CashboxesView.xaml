<UserControl x:Class="HardwarePaintShop.Desktop.Views.Finance.CashboxesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="الخزائن ووسائل التحصيل" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="كل حركة مالية مرتبطة بخزينة، ولا يمكن تعديل الرصيد يدويًا"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="إجمالي الأرصدة النشطة" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalBalance, StringFormat='{}{0:N2} ج.م'}"
                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="الخزائن المسجلة" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <CheckBox Grid.Column="1" Content="إظهار المعطّل" IsChecked="{Binding IncludeInactive}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="2" Content="تحديث" Command="{Binding LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" Height="3"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <DataGrid ItemsSource="{Binding Cashboxes}" SelectedItem="{Binding SelectedCashbox}"
                              Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الخزينة" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="افتتاحي" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="125"/>
                            <DataGridCheckBoxColumn Header="نشطة" Binding="{Binding IsActive}" Width="65"/>
                            <DataGridTemplateColumn Header="" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="تعديل" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,5,0"
                                                    Command="{Binding DataContext.EditCashboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource DangerButtonStyle}" Padding="8,4"
                                                    Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}, ConverterParameter='تعطيل|تفعيل'}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}">
                        <Run Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='تعديل الخزينة|خزينة جديدة'}"/>
                    </TextBlock>
                    <TextBlock Text="اسم الخزينة *" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBoxStyle}" Margin="0,5,0,12"/>
                    <TextBlock Text="الرصيد الافتتاحي" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding FormOpeningBalance, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBoxStyle}" Margin="0,5,0,5"
                             IsReadOnly="{Binding IsEditing}"/>
                    <TextBlock Text="يُحدد مرة واحدة عند الإنشاء، وبعدها يتغير الرصيد بالحركات فقط."
                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <CheckBox Content="الخزينة نشطة" IsChecked="{Binding FormIsActive}" Margin="0,0,0,14"/>
                    <Border Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                            CornerRadius="7" Padding="10" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Background" Value="#ECFDF5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="حفظ الخزينة" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="جديد" Command="{Binding NewCashboxCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
